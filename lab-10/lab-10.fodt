    <text:p text:style-name="P1">Due: <text:span text:style-name="T1">05</text:span> <text:span text:style-name="T1">December</text:span> 2025<text:tab/><text:tab/><text:span text:style-name="T1">Fall</text:span> 2025</text:p>
